# ===========================================
# Eraao Production Environment Configuration
# ===========================================

# --- Database ---
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# --- JWT (generate with: openssl rand -hex 32) ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_KEY

# --- Domain ---
ALLOWED_ORIGINS=https://eraao.com,https://www.eraao.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# --- SSLCommerz ---
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWD=your_store_password
SSLCOMMERZ_IS_SANDBOX=False

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@eraao.com
SMTP_PASSWORD=your_app_password
